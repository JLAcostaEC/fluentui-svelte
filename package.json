{
	"name": "fluentui-svelte",
	"version": "0.7.2",
	"description": "Modern Fluent UI 2 Components for Svelte 5",
	"author": {
		"name": "Jorge Acosta",
		"url": "https://github.com/JLAcostaEC"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JLAcostaEC/fluentui-svelte.git"
	},
	"license": "MIT",
	"keywords": [
		"svelte",
		"fluent",
		"fluent-ui",
		"fluentui",
		"components",
		"fluentui-components",
		"svelte-components",
		"svelte-5",
		"svelte-5-components",
		"winui",
		"win-ui",
		"windows-ui",
		"microsoft-ui"
	],
	"scripts": {
		"dev": "pnpm urls && vite dev",
		"build:site": "pnpm urls && pnpm check && vite build && pnpm prepare",
		"build": "pnpm urls && pnpm check && vite build && npm run prepack",
		"preview": "wrangler pages dev",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/i18n --strategy url cookie baseLocale --emit-ts-declarations --silent",
		"check": "pnpm i18n && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm i18n && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"deploy": "pnpm run build:site && wrangler deploy",
		"urls": "node scripts/gen-urls.js && node scripts/gen-llms.js",
		"cf-typegen": "wrangler types",
		"changeset:version": "changeset version && node scripts/gen-llms.js && git add --all",
		"changeset:publish": "changeset publish"
	},
	"files": [
		"dist",
		"!dist/**/tests/**",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/docs/**",
		"dist/**/docs/llms.md",
		"skills"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./theme.css": {
			"import": "./dist/css/theme.css",
			"default": "./dist/css/theme.css"
		},
		"./reset.css": {
			"import": "./dist/css/reset.css",
			"default": "./dist/css/reset.css"
		},
		"./typography.css": {
			"import": "./dist/css/typography.css",
			"default": "./dist/css/typography.css"
		},
		"./class-darkmode.css": {
			"import": "./dist/css/class-darkmode.css",
			"default": "./dist/css/class-darkmode.css"
		},
		"./media-darkmode.css": {
			"import": "./dist/css/media-darkmode.css",
			"default": "./dist/css/media-darkmode.css"
		}
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@useupup/core": "3.3.5",
		"@videojs/html": "10.3.0",
		"fluentui-icons-svelte": "^1.2.0",
		"mode-watcher": "^1.1.0",
		"runed": "^0.38.0",
		"tabspot": "^0.8.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@humanspeak/svelte-virtual-list": "^0.5.15",
		"@inlang/paraglide-js": "^2.29.3",
		"@inlang/paraglide-js-svelte": "^1.0.4",
		"@jlacostaec/paraglide-markup-svelte": "0.1.0",
		"@jlacostaec/propsmith": "^0.2.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "^5.1.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.14.0",
		"mdsvex": "^0.12.8",
		"panzoom": "^9.4.4",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"rehype-class-names": "^2.0.0",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.6.0",
		"simplex-noise": "^4.0.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-meta-tags": "^5.0.3",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.156.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#types": "./src/lib/types/index.js",
		"#internal": "./src/lib/internal/index.js",
		"#components/*": "./src/lib/components/*",
		"#css/*": "./src/lib/css/*",
		"#site/*": "./src/site/*",
		"#i18n/*": "./src/i18n/*",
		"#constants": "./src/lib/internal/constants.js"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.16.1"
}
