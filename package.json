{
	"name": "fluentui-svelte",
	"version": "0.1.0",
	"description": "Modern Fluent UI 2 Components for Svelte 5",
	"author": {
		"name": "Jorge Acosta",
		"url": "https://github.com/JLAcostaEC"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JLAcostaEC/fluentui-svelte.git"
	},
	"license": "MIT",
	"keywords": [
		"svelte",
		"fluent",
		"fluent-ui",
		"fluentui",
		"components",
		"fluentui-components",
		"svelte-components",
		"svelte-5",
		"svelte-5-components",
		"winui",
		"win-ui",
		"windows-ui",
		"microsoft-ui"
	],
	"scripts": {
		"dev": "pnpm urls && vite dev",
		"build:site": "pnpm urls && vite build",
		"build": "vite build && npm run prepack",
		"preview": "pnpm run build && wrangler pages dev",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"deploy": "pnpm run build && wrangler pages deploy",
		"urls": "node scripts/gen-urls.js",
		"cf-typegen": "wrangler types src/worker-configuration.d.ts"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./theme.css": {
			"import": "./dist/css/theme.css",
			"default": "./dist/css/theme.css"
		},
		"./reset.css": {
			"import": "./dist/css/reset.css",
			"default": "./dist/css/reset.css"
		},
		"./typography.css": {
			"import": "./dist/css/typography.css",
			"default": "./dist/css/typography.css"
		},
		"./class-darkmode.css": {
			"import": "./dist/css/class-darkmode.css",
			"default": "./dist/css/class-darkmode.css"
		},
		"./media-darkmode.css": {
			"import": "./dist/css/media-darkmode.css",
			"default": "./dist/css/media-darkmode.css"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@floating-ui/dom": "^1.7.6",
		"@humanspeak/svelte-virtual-list": "^0.5.9",
		"@inlang/paraglide-js": "^2.18.2",
		"@inlang/paraglide-js-svelte": "^1.0.3",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24.13.3",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fluentui-icons-svelte": "^1.1.1",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"mode-watcher": "^1.1.0",
		"panzoom": "^9.4.4",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"rehype-class-names": "^2.0.0",
		"rehype-slug": "^6.0.0",
		"runed": "^0.37.1",
		"shiki": "^4.3.1",
		"simplex-noise": "^4.0.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tabspot": "^0.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.110.0"
	}
}