{
	"name": "fluentui-svelte",
	"version": "0.1.0",
	"description": "Modern Fluent UI 2 Components for Svelte 5",
	"author": {
		"name": "Jorge Acosta",
		"url": "https://github.com/JLAcostaEC"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JLAcostaEC/fluentui-svelte.git"
	},
	"license": "MIT",
	"keywords": [
		"svelte",
		"fluent",
		"fluent-ui",
		"fluentui",
		"components",
		"fluentui-components",
		"svelte-components",
		"svelte-5",
		"svelte-5-components",
		"winui",
		"win-ui",
		"windows-ui",
		"microsoft-ui"
	],
	"scripts": {
		"dev": "pnpm urls && vite dev",
		"build:site": "pnpm urls && vite build && pnpm prepare",
		"build": "pnpm urls && vite build && npm run prepack",
		"preview": "pnpm run build && wrangler pages dev",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"deploy": "pnpm run build:site && wrangler pages deploy",
		"urls": "node scripts/gen-urls.js",
		"cf-typegen": "wrangler types src/worker-configuration.d.ts",
		"changeset:version": "changeset version && git add --all",
		"changeset:publish": "changeset publish"
	},
	"files": [
		"dist",
		"!dist/**/tests/**",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/docs/**",
		"dist/**/docs/llms.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./theme.css": {
			"import": "./dist/css/theme.css",
			"default": "./dist/css/theme.css"
		},
		"./reset.css": {
			"import": "./dist/css/reset.css",
			"default": "./dist/css/reset.css"
		},
		"./typography.css": {
			"import": "./dist/css/typography.css",
			"default": "./dist/css/typography.css"
		},
		"./class-darkmode.css": {
			"import": "./dist/css/class-darkmode.css",
			"default": "./dist/css/class-darkmode.css"
		},
		"./media-darkmode.css": {
			"import": "./dist/css/media-darkmode.css",
			"default": "./dist/css/media-darkmode.css"
		}
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"fluentui-icons-svelte": "^1.1.1",
		"mode-watcher": "^1.1.0",
		"runed": "^0.37.1",
		"tabspot": "^0.8.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@eslint/js": "^10.0.1",
		"@humanspeak/svelte-virtual-list": "^0.5.14",
		"@inlang/paraglide-js": "^2.24.1",
		"@inlang/paraglide-js-svelte": "^1.0.4",
		"@jlacostaec/propsmith": "^0.2.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.2.0",
		"@vitest/browser-playwright": "^4.1.11",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"mdsvex": "^0.12.8",
		"panzoom": "^9.4.4",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.24",
		"rehype-class-names": "^2.0.0",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.4.3",
		"simplex-noise": "^4.0.3",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0",
		"wrangler": "^4.124.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.4.0"
}
