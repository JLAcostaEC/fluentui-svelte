## {m.global_usage()}

<p><I18nMarkupMessage message={m.annotated_scroll_bar_usage} /></p>

```svelte
<script lang="ts">
  import { AnnotatedScrollBar } from 'fluentui-svelte';

  let gallery = $state<HTMLDivElement | null>(null);
  const years = Array.from({ length: 50 }, (_, index) => 2024 - index);
</script>

<div class="collection">
  <div class="gallery" bind:this={gallery}>
    {#each years as year (year)}
      <section data-scroll-label={year}><h3>{year}</h3></section>
    {/each}
  </div>
  <AnnotatedScrollBar scrollRef={gallery} aria-label="Photo timeline" />
</div>

<style>
  .collection { display: flex; gap: 16px; height: 320px; }
  .gallery { flex: 1; overflow: auto; scrollbar-width: none; }
  section { height: 240px; }
</style>
```

