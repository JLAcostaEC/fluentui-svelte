<script lang="ts">
  import { I18nMarkupMessage } from '@jlacostaec/paraglide-markup-svelte';
  import { Checkbox } from '$lib/index.js';
  import Showcase from '$site/components/showcase/showcase.svelte';
  import { m } from '$i18n/messages.js';

  const labelCode = `
<Checkbox />
<Checkbox>FluentUI Checkbox</Checkbox>
<Checkbox>Another Checkbox</Checkbox>`;

  const checkedCode = `
<Checkbox>Unchecked</Checkbox>
<Checkbox checked>Checked</Checkbox>`;

  const indeterminateCode = `
<Checkbox indeterminate>Indeterminate</Checkbox>`;

  const disabledCode = `
<Checkbox disabled>Disabled</Checkbox>
<Checkbox checked disabled>Checked & Disabled</Checkbox>`;

  const valueCode = `
<Checkbox value="checkbox-value">Checkbox with Value</Checkbox>`;
</script>

### {m.cb_label_title()}

<p class="fs-docs"><I18nMarkupMessage message={m.cb_label_description} /></p>

```svelte
<Checkbox>I'm Labeled</Checkbox>
<Checkbox aria-label="Without visible text" />
```

### {m.global_indeterminate()}

<p class="fs-docs"><I18nMarkupMessage message={m.cb_indeterminate_description} /></p>

<Showcase minHeight="100px" columns={1} code={indeterminateCode}>
  <Checkbox indeterminate>Indeterminate</Checkbox>
</Showcase>

### {m.global_disabled()}

<p class="fs-docs"><I18nMarkupMessage message={m.cb_disabled_description} /></p>

<Showcase minHeight="100px" code={disabledCode}>
  <Checkbox disabled>Disabled</Checkbox>
  <Checkbox checked disabled>Checked & Disabled</Checkbox>
</Showcase>