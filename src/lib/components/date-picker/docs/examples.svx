<script lang="ts">
  import { DatePicker } from '#lib/index.js';
  import Showcase from '#site/components/showcase/showcase.svelte';
  import { m } from '#i18n/messages.js';
  import { I18nMarkupMessage } from '@jlacostaec/paraglide-markup-svelte';

  const formatCode = `
<DatePicker format="dd/MM/yyyy" />
<DatePicker format="MM/dd/yyyy" />`;

  const hideColumnsCode = `<DatePicker hideDays />`;
</script>

### {m.dp_format_title()}

<p><I18nMarkupMessage message={m.dp_format_description} /></p>

<Showcase columns={1} code={formatCode} minHeight="0" disablePanZoom showOverflow>
  <DatePicker format="dd/MM/yyyy" />
