  import { Dialog, DialogTrigger, DialogSurface, DialogTitle, DialogContent } from '#lib/index.js';
  import Showcase from '#site/components/showcase/showcase.svelte';
  import { m } from '#i18n/messages.js';
</script>

# Dialog <StatusBadge />

{m.dialog_description()}

<DocsActions />

<Showcase columns={1} minHeight="0" disablePanZoom showOverflow>
  <Dialog>
    <DialogTrigger>Open Dialog</DialogTrigger>
    <DialogSurface>
      <DialogTitle>Dialog Title</DialogTitle>
      <DialogContent>
        <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, voluptates.</p>
      </DialogContent>
