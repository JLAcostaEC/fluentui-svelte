<script lang="ts">
  import { Dialog, DialogTrigger, DialogSurface, DialogTitle, DialogContent, DialogActions, Button } from '$lib/index.js';
  import Showcase from '$site/components/showcase/showcase.svelte';
  import { m } from '$i18n/messages.js';
  import type { DialogAnimation, DialogPosition } from '$lib/index.js';

  const animations: DialogAnimation[] = ['fade', 'zoom', 'slide', 'bounce'];
  const animationCode = `
<script>
  import { Dialog, DialogTrigger, DialogSurface, DialogTitle, DialogContent } from 'fluentui-svelte';
<\/script>

<Dialog animation="zoom" duration="normal">
  <DialogTrigger>zoom</DialogTrigger>
  <DialogSurface>
    <DialogTitle>Dialog Title</DialogTitle>
    <DialogContent>Dialog body content.</DialogContent>
  </DialogSurface>
</Dialog>

<!-- Theme token: duration="fast" or duration="--fs-fast-duration" -->
<!-- Custom milliseconds: duration={200} -->`;

  const positions: DialogPosition[] = [
    'top-start', 'top-center', 'top-end',
    'middle-start', 'middle-center', 'middle-end',
    'bottom-start', 'bottom-center', 'bottom-end'
  ];

  const positionCode = `
<script>
  import { Dialog, DialogTrigger, DialogSurface, DialogTitle, DialogContent } from 'fluentui-svelte';
<\/script>

<Dialog position="top-end">
  <DialogTrigger>top-end</DialogTrigger>
  <DialogSurface>
    <DialogTitle>Dialog Title</DialogTitle>
    <DialogContent>Dialog body content.</DialogContent>
  </DialogSurface>
</Dialog>`;

  let actionsDialog = $state();
  let alertDialog = $state();
  let controlledOpen = $state(false);
  let eventsDialog = $state();
  let openChanges = $state<string[]>([]);

  const actionsCode = `
<script>
  import { Dialog, DialogTrigger, DialogSurface, DialogTitle, DialogContent, DialogActions, Button } from 'fluentui-svelte';
  let dialog = $state();
<\/script>

<Dialog bind:this={dialog}>
  <DialogTrigger>Actions Dialog</DialogTrigger>
  <DialogSurface>
    <DialogTitle>Dialog Title</DialogTitle>
    <DialogContent>
      <p>Dialog body content.</p>
    </DialogContent>
    <DialogActions fluid>
      <Button>Save</Button>
      <Button appearance="standard" onclick={() => dialog.closeDialog()}>Close</Button>
    </DialogActions>
  </DialogSurface>
</Dialog>`;

  const nonModalCode = `
<script>
  import { Dialog, DialogTrigger, DialogSurface, DialogTitle, DialogContent } from 'fluentui-svelte';
<\/script>

<Dialog type="non-modal">
  <DialogTrigger>Non-modal Dialog</DialogTrigger>
  <DialogSurface>
    <DialogTitle>Dialog Title</DialogTitle>
    <DialogContent>
      <p>The page behind this dialog stays interactive.</p>
    </DialogContent>
  </DialogSurface>
</Dialog>`;

  const alertCode = `
<script>
  import { Dialog, DialogTrigger, DialogSurface, DialogTitle, DialogContent, DialogActions, Button } from 'fluentui-svelte';
  let dialog = $state();
<\/script>

<Dialog type="alert" bind:this={dialog}>
  <DialogTrigger>Alert Dialog</DialogTrigger>
  <DialogSurface>
    <DialogTitle>Discard changes?</DialogTitle>
    <DialogContent>
      <p>Your changes will be lost.</p>
    </DialogContent>
    <DialogActions>
      <Button appearance="standard" onclick={() => dialog.closeDialog()}>Cancel</Button>
      <Button onclick={() => dialog.closeDialog()}>Discard</Button>
    </DialogActions>
  </DialogSurface>
</Dialog>`;

  const controlledCode = `
<script>
  import { Dialog, DialogSurface, DialogTitle, DialogContent, Button } from 'fluentui-svelte';
  let open = $state(false);
<\/script>

<Button onclick={() => (open = true)}>Open dialog</Button>
<p>open: {open}</p>

<Dialog type="non-modal" bind:open>
  <DialogSurface>
    <DialogTitle>Controlled Dialog</DialogTitle>
    <DialogContent>
      <p>This dialog follows the bound open state.</p>
    </DialogContent>
  </DialogSurface>
</Dialog>`;

  const openChangeCode = `
<script>
  import { Dialog, DialogTrigger, DialogSurface, DialogTitle, DialogContent, DialogActions, Button } from 'fluentui-svelte';
  let dialog = $state();
  let changes = $state([]);
<\/script>

<Dialog bind:this={dialog} onOpenChange={(open) => (changes = [...changes, \`onOpenChange(\${open})\`].slice(-5))}>
  <DialogTrigger>Events Dialog</DialogTrigger>
  <DialogSurface>
    <DialogTitle>Dialog Title</DialogTitle>
    <DialogContent>
      <p>Close it with Escape, by clicking outside or with the button.</p>
    </DialogContent>
    <DialogActions>
      <Button onclick={() => dialog.closeDialog()}>Close</Button>
    </DialogActions>
  </DialogSurface>
</Dialog>

<p>{changes.length ? changes.join(', ') : 'No changes yet'}</p>`;
</script>

### {m.dialog_position_title()}

{m.dialog_position_description()}

<Showcase columns={3} columnWidth="auto" gap="12px" minHeight="0" disablePanZoom showOverflow code={positionCode}>
  {#each positions as position (position)}
    <Dialog {position}>
      <DialogTrigger>{position}</DialogTrigger>
      <DialogSurface>
        <DialogTitle>{position}</DialogTitle>
        <DialogContent>Dialog body content.</DialogContent>
      </DialogSurface>
    </Dialog>
  {/each}
</Showcase>

### {m.dialog_animation_title()}

{m.dialog_animation_description()}

<Showcase columns={2} columnWidth="auto" gap="12px" minHeight="0" disablePanZoom showOverflow code={animationCode}>
  {#each animations as animation (animation)}
    <Dialog {animation} duration="normal">
      <DialogTrigger>{animation}</DialogTrigger>
      <DialogSurface>
        <DialogTitle>{animation}</DialogTitle>
        <DialogContent>{m.dialog_animation_content()}</DialogContent>
      </DialogSurface>
    </Dialog>
  {/each}
</Showcase>

### {m.dialog_with_actions_title()}

{m.dialog_with_actions_description()}

<Showcase columns={1} minHeight="0" disablePanZoom showOverflow code={actionsCode}>
  <Dialog bind:this={actionsDialog}>
    <DialogTrigger>Actions Dialog</DialogTrigger>
    <DialogSurface>
      <DialogTitle>Dialog Title</DialogTitle>
      <DialogContent>
        <p>Dialog body content.</p>
      </DialogContent>
      <DialogActions fluid>
        <Button>Save</Button>
        <Button appearance="standard" onclick={() => actionsDialog.closeDialog()}>Close</Button>
      </DialogActions>
    </DialogSurface>
  </Dialog>
</Showcase>

### {m.dialog_non_modal_title()}

{m.dialog_non_modal_description()}

<Showcase columns={1} minHeight="0" disablePanZoom showOverflow code={nonModalCode}>
  <Dialog type="non-modal">
    <DialogTrigger>Non-modal Dialog</DialogTrigger>
    <DialogSurface>
      <DialogTitle>Dialog Title</DialogTitle>
      <DialogContent>
        <p>The page behind this dialog stays interactive.</p>
      </DialogContent>
    </DialogSurface>
  </Dialog>
</Showcase>

### {m.dialog_alert_title()}

{m.dialog_alert_description()}

<Showcase columns={1} minHeight="0" disablePanZoom showOverflow code={alertCode}>
  <Dialog type="alert" bind:this={alertDialog}>
    <DialogTrigger>Alert Dialog</DialogTrigger>
    <DialogSurface>
      <DialogTitle>Discard changes?</DialogTitle>
      <DialogContent>
        <p>Your changes will be lost.</p>
      </DialogContent>
      <DialogActions>
        <Button appearance="standard" onclick={() => alertDialog.closeDialog()}>Cancel</Button>
        <Button onclick={() => alertDialog.closeDialog()}>Discard</Button>
      </DialogActions>
    </DialogSurface>
  </Dialog>
</Showcase>

### {m.dialog_controlled_title()}

{m.dialog_controlled_description()}

<Showcase columns={1} minHeight="0" disablePanZoom showOverflow code={controlledCode}>
  <Button onclick={() => (controlledOpen = true)}>Open dialog</Button>
  <p>open: {controlledOpen}</p>
  <Dialog type="non-modal" bind:open={controlledOpen}>
    <DialogSurface>
      <DialogTitle>Controlled Dialog</DialogTitle>
      <DialogContent>
        <p>This dialog follows the bound open state.</p>
      </DialogContent>
    </DialogSurface>
  </Dialog>
</Showcase>

### {m.dialog_on_open_change_title()}

{m.dialog_on_open_change_description()}

<Showcase columns={1} minHeight="0" disablePanZoom showOverflow code={openChangeCode}>
  <Dialog bind:this={eventsDialog} onOpenChange={(open) => (openChanges = [...openChanges, `onOpenChange(${open})`].slice(-5))}>
    <DialogTrigger>Events Dialog</DialogTrigger>
    <DialogSurface>
      <DialogTitle>Dialog Title</DialogTitle>
      <DialogContent>
        <p>Close it with Escape, by clicking outside or with the button.</p>
      </DialogContent>
      <DialogActions>
        <Button onclick={() => eventsDialog.closeDialog()}>Close</Button>
      </DialogActions>
    </DialogSurface>
  </Dialog>
  <p>{openChanges.length ? openChanges.join(', ') : 'No changes yet'}</p>
</Showcase>
