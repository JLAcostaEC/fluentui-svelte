# Drawer
<p><I18nMarkupMessage message={m.drawer_description} /></p>

<Showcase columns={1} minHeight="0" disablePanZoom showOverflow fluid>
  <Button appearance="accent" onclick={() => (open = true)}>Open drawer</Button>
  <Drawer bind:open>
    <DrawerHeader title="Default drawer" />
    <DrawerBody>
      <p>{m.drawer_example_default()}</p>
    </DrawerBody>
    <DrawerFooter>
      <Button appearance="accent" onclick={() => (open = false)}>Done</Button>
    </DrawerFooter>
  </Drawer>
</Showcase>

