<script>
  import { Button, Drawer, DrawerHeader, DrawerBody, DrawerFooter } from 'fluentui-svelte';
  let open = $state(false);
</script>

<Button onclick={() => (open = true)}>Open drawer</Button>
<Drawer bind:open>
  <DrawerHeader title="Default drawer" />
  <DrawerBody>
    <p>Drawer content</p>
  </DrawerBody>
  <DrawerFooter>
    <Button appearance="accent" onclick={() => (open = false)}>Done</Button>
