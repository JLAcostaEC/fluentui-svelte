<script lang="ts">
  import { Button, Drawer, DrawerHeader, DrawerBody, DrawerFooter } from '#lib/index.js';
  import Showcase from '#site/components/showcase/showcase.svelte';
  import { m } from '#i18n/messages.js';

  let open = $state(false);
</script>

# Drawer
{m.drawer_description()}

<Showcase columns={1} minHeight="0" disablePanZoom showOverflow fluid>
  <Button appearance="accent" onclick={() => (open = true)}>Open drawer</Button>
  <Drawer bind:open>
    <DrawerHeader title="Default drawer" />
    <DrawerBody>
      <p>A modal drawer slides in from the start edge. Press Escape or click outside to close it.</p>
    </DrawerBody>
    <DrawerFooter>
      <Button appearance="accent" onclick={() => (open = false)}>Done</Button>
    </DrawerFooter>
  </Drawer>
</Showcase>

## {m.global_usage()}
