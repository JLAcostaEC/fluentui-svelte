<script lang="ts">
  import { I18nMarkupMessage } from '@jlacostaec/paraglide-markup-svelte';
  import StatusBadge from '#site/components/status-badge/status-badge.svelte';
  import DocsActions from '#site/components/docs/docs-actions.svelte';
  import { LiteFilter, LiteFilterItem } from '#lib/index.js';
  import Showcase from '#site/components/showcase/showcase.svelte';
  import { m } from '#i18n/messages.js';

  const filters = ['All', 'Apps', 'Documents', 'Web', 'People', 'IMG', 'JPG'];
  const labels: Record<string, () => string> = {
    all: m.lite_filter_example_all,
    apps: m.lite_filter_example_apps,
    documents: m.lite_filter_example_documents,
    people: m.lite_filter_example_people
  };
  let filter = $state('all');
</script>

# LiteFilter <StatusBadge />
<p><I18nMarkupMessage message={m.lite_filter_description} /></p>

<DocsActions />

<Showcase columns={1} minHeight="0" disablePanZoom showOverflow fluid>
  <LiteFilter aria-label={m.lite_filter_example_search_filters()} bind:selectedValue={filter}>
    {#each filters as text (text)}
      <LiteFilterItem value={text.toLowerCase()}>{labels[text.toLowerCase()]?.() ?? text}</LiteFilterItem>
    {/each}
  </LiteFilter>
</Showcase>

## {m.global_usage()}
