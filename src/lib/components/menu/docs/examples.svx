<script lang="ts">
  import { Button, SplitButton, Menu, MenuTrigger, ContextMenuTrigger, MenuPopover, MenuList, MenuGroup, MenuItem, MenuDivider, MenuItemCheckbox, MenuItemSwitch, MenuItemRadio, MenuCommandBar, MenuCommandBarItem } from '#lib/index.js';
  import { AccessTimeRegular, ChevronRightFilled, CutRegular, CopyRegular, ClipboardPasteRegular, DeleteRegular, ShareRegular } from 'fluentui-icons-svelte';
  import { m } from '#i18n/messages.js';

  let checkedValues = $state({});
  let contextMenuBox: HTMLElement | null = $state(null);
</script>

## {m.menu_more_examples_title()}

### {m.menu_checkable_nested_submenus_title()}

<Menu hasCheckmarks hasIcons {checkedValues} onCheckedValueChange={(e, value) => { checkedValues = value; }}>
  <MenuTrigger>
    {#snippet children({ state, menuTriggerProps })}
      <Button isMenuButton bind:ref={state.ref} {...menuTriggerProps}>
        <AccessTimeRegular /> Open Menu
      </Button>
    {/snippet}
  </MenuTrigger>
  <MenuPopover>
    <MenuList>
      <MenuItem subText="An explanation here">Item With Subtext</MenuItem>
      <MenuDivider />
      <MenuItem disabled>I'm Disabled</MenuItem>
      <MenuItemCheckbox name="item4" value="item4" icon={AccessTimeRegular} subText="Click doesn't close menu">I'm a checkbox</MenuItemCheckbox>
      <MenuItemSwitch subText="Click doesn't close menu">I'm a switch</MenuItemSwitch>
      <MenuItemRadio name="item6" value="item6" icon={AccessTimeRegular} subText="Click closes menu">I'm a radio</MenuItemRadio>
      <Menu>
        <MenuTrigger>
          {#snippet children({ state, menuTriggerProps })}
            <Button bind:ref={state.ref} icon={ChevronRightFilled} {...menuTriggerProps}>I'm a nested menu</Button>
          {/snippet}
        </MenuTrigger>
        <MenuPopover>
          <MenuList>
            <MenuItem>Item 1</MenuItem>
            <MenuItem>Item 2</MenuItem>
          </MenuList>
        </MenuPopover>
      </Menu>
    </MenuList>
  </MenuPopover>
</Menu>

```svelte
<Menu hasCheckmarks hasIcons {checkedValues} onCheckedValueChange={(e, value) => (checkedValues = value)}>
	<MenuTrigger>
		{#snippet children({ state, menuTriggerProps })}
			<Button isMenuButton bind:ref={state.ref} {...menuTriggerProps}>
				<AccessTimeRegular /> Open Menu
			</Button>
		{/snippet}
	</MenuTrigger>
	<MenuPopover>
		<MenuList>
			<MenuItem subText="An explanation here">Item With Subtext</MenuItem>
			<MenuDivider />
			<MenuItem disabled>I'm Disabled</MenuItem>
			<MenuItemCheckbox name="item4" value="item4" icon={AccessTimeRegular}>I'm a checkbox</MenuItemCheckbox>
			<MenuItemSwitch>I'm a switch</MenuItemSwitch>
