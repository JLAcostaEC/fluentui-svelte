### {m.menu_splitbutton_trigger_title()}

<Menu>
  <MenuTrigger>
    {#snippet children({ state, menuTriggerProps, primaryButtonProps })}
      <SplitButton bind:menuTriggerRef={state.ref} menuTriggerProps={{ ...menuTriggerProps, 'aria-label': 'More options' }} primaryButtonProps={{ onclick: () => alert('Primary action'), ...primaryButtonProps }}>
        Primary Action
      </SplitButton>
    {/snippet}
  </MenuTrigger>
  <MenuPopover>
    <MenuList>
      <MenuGroup header="Group 1">
        <MenuItem>Item 1</MenuItem>
        <MenuItem>Item 2</MenuItem>
      </MenuGroup>
      <MenuDivider />
      <MenuGroup header="Group 2">
        <MenuItem>Item 3</MenuItem>
        <MenuItem>Item 4</MenuItem>
      </MenuGroup>
    </MenuList>
  </MenuPopover>
</Menu>

```svelte
<Menu>
	<MenuTrigger>
		{#snippet children({ state, menuTriggerProps, primaryButtonProps })}
			<SplitButton
				bind:menuTriggerRef={state.ref}
				menuTriggerProps={{ ...menuTriggerProps, 'aria-label': 'More options' }}
				primaryButtonProps={{ onclick: () => alert('Primary action'), ...primaryButtonProps }}
			>
				Primary Action
			</SplitButton>
		{/snippet}
	</MenuTrigger>
	<MenuPopover>
		<MenuList>
			<MenuItem>Item 1</MenuItem>
			<MenuItem>Item 2</MenuItem>
		</MenuList>
	</MenuPopover>
</Menu>
```

### {m.menu_command_bar_title()}

{m.menu_command_bar_description()}

{m.menu_command_bar_keyboard_description()}

{#snippet commands()}
  <MenuCommandBarItem icon={CutRegular} label="Cut" />
  <MenuCommandBarItem icon={CopyRegular} label="Copy" />
  <MenuCommandBarItem icon={ClipboardPasteRegular} label="Paste" />
  <MenuCommandBarItem icon={ShareRegular} label="Share" />
  <MenuCommandBarItem icon={DeleteRegular} label="Delete" />
{/snippet}

{#snippet secondary()}
  <MenuItem>Select all</MenuItem>
  <MenuItem>Rename</MenuItem>
{/snippet}

<div style="display: flex; gap: 1rem; flex-wrap: wrap;">
  <Menu>
    <MenuTrigger>
      {#snippet children({ state, menuTriggerProps })}
        <Button bind:ref={state.ref} {...menuTriggerProps}>Commands on top</Button>
      {/snippet}
    </MenuTrigger>
    <MenuPopover>
      <MenuList>
        <MenuCommandBar overflow={secondary}>
          {@render commands()}
        </MenuCommandBar>
        <MenuItem>Open</MenuItem>
        <MenuItem>Open with</MenuItem>
        <MenuItem>Properties</MenuItem>
      </MenuList>
    </MenuPopover>
  </Menu>
  <Menu>
    <MenuTrigger>
      {#snippet children({ state, menuTriggerProps })}
        <Button bind:ref={state.ref} {...menuTriggerProps}>Commands at the bottom</Button>
      {/snippet}
    </MenuTrigger>
    <MenuPopover>
      <MenuList>
        <MenuItem>Open</MenuItem>
        <MenuItem>Open with</MenuItem>
        <MenuItem>Properties</MenuItem>
        <MenuCommandBar position="bottom" overflow={secondary}>
          {@render commands()}
        </MenuCommandBar>
      </MenuList>
    </MenuPopover>
  </Menu>
  <Menu>
    <MenuTrigger>
      {#snippet children({ state, menuTriggerProps })}
        <Button bind:ref={state.ref} {...menuTriggerProps}>Labels and dividers</Button>
      {/snippet}
    </MenuTrigger>
    <MenuPopover>
      <MenuList>
        <MenuCommandBar showLabels showDividers>
          {@render commands()}
        </MenuCommandBar>
        <MenuItem>Open</MenuItem>
        <MenuItem>Open with</MenuItem>
        <MenuItem>Properties</MenuItem>
      </MenuList>
    </MenuPopover>
  </Menu>
</div>

```svelte
<Menu>
	<MenuTrigger>
		{#snippet children({ state, menuTriggerProps })}
			<Button bind:ref={state.ref} {...menuTriggerProps}>Commands on top</Button>
		{/snippet}
	</MenuTrigger>
	<MenuPopover>
		<MenuList>
			<!-- position="bottom" when the bar comes after the items -->
			<MenuCommandBar>
				<MenuCommandBarItem icon={CutRegular} label="Cut" />
				<MenuCommandBarItem icon={CopyRegular} label="Copy" />
				<MenuCommandBarItem icon={ClipboardPasteRegular} label="Paste" />
				{#snippet overflow()}
					<MenuItem>Select all</MenuItem>
					<MenuItem>Rename</MenuItem>
				{/snippet}
			</MenuCommandBar>
			<MenuItem>Open</MenuItem>
			<MenuItem>Open with</MenuItem>
			<MenuItem>Properties</MenuItem>
		</MenuList>
	</MenuPopover>
</Menu>
```

