<script lang="ts">
  import { I18nMarkupMessage } from '@jlacostaec/paraglide-markup-svelte';
  import { FlipView, PipsPager } from '#lib/index.js';
  import Showcase from '#site/components/showcase/showcase.svelte';
  import { m } from '#i18n/messages.js';

  const photos = ['1506905925346-21bda4d32df4', '1501785888041-af3ef285b470', '1470071459604-3b5ec3a7fe05', '1441974231531-c6227db76b6e', '1469474968028-56623f02e42e'];
  let orientationIndex = $state({ horizontal: 1, vertical: 1 });
  let buttonsIndex = $state({ visible: 0, hover: 0, wrap: 4 });
  let longIndex = $state(0);
  let numbersIndex = $state(2);
  let photoIndex = $state(0);

  const flipViewCode = `<script>
  import { FlipView, PipsPager } from 'fluentui-svelte';
  const photos = ['1506905925346-21bda4d32df4', '1501785888041-af3ef285b470', '1470071459604-3b5ec3a7fe05', '1441974231531-c6227db76b6e', '1469474968028-56623f02e42e'];
  let index = $state(0);
<\/script>

<FlipView aria-label="Landscapes" bind:index style="width: 24rem; height: 12rem;">
  {#each photos as id, i (id)}
    <img src="https://images.unsplash.com/photo-{id}?w=768&h=384&fit=crop&q=70" alt="Landscape {i + 1}" />
  {/each}
</FlipView>
<PipsPager aria-label="Landscapes" numberOfPages={photos.length} bind:index />`;
  const orientationCode = `<script>
  import { PipsPager } from 'fluentui-svelte';
  let index = $state(1);
<\/script>

<PipsPager aria-label="Horizontal" numberOfPages={5} bind:index />
<PipsPager aria-label="Vertical" numberOfPages={5} orientation="vertical" bind:index />`;
  const buttonsCode = `<script>
  import { PipsPager } from 'fluentui-svelte';
  let index = $state(0);
<\/script>

<PipsPager aria-label="Always" numberOfPages={5} buttonVisibility="visible" bind:index />
<PipsPager aria-label="On hover" numberOfPages={5} buttonVisibility="hover" bind:index />
<PipsPager aria-label="Wrap" numberOfPages={5} buttonVisibility="visible" wrap bind:index />`;
  const maxVisibleCode = `<script>
  import { PipsPager } from 'fluentui-svelte';
  let index = $state(0);
<\/script>

<PipsPager aria-label="Chapters" numberOfPages={20} maxVisiblePips={7} buttonVisibility="visible" bind:index />
<p>Chapter {index + 1} of 20</p>`;
  const numbersCode = `<script>
  import { PipsPager } from 'fluentui-svelte';
  let index = $state(2);
<\/script>

<PipsPager aria-label="Steps" numberOfPages={8} showNumbers bind:index />`;
</script>

### {m.pips_pager_flip_view_title()}

<p><I18nMarkupMessage message={m.pips_pager_flip_view_description} /></p>

<Showcase columns={1} code={flipViewCode} minHeight="0" disablePanZoom showOverflow fluid>
  <div class="stack">
    <FlipView aria-label="Landscapes" bind:index={photoIndex} style="width: 24rem; max-width: 100%; height: 12rem;">
      {#each photos as id, i (id)}
        <img src="https://images.unsplash.com/photo-{id}?w=768&h=384&fit=crop&q=70" alt="Landscape {i + 1}" loading="lazy" />
      {/each}
    </FlipView>
    <PipsPager aria-label="Landscapes" numberOfPages={photos.length} bind:index={photoIndex} />
  </div>
</Showcase>

### {m.pips_pager_orientation_title()}

<p><I18nMarkupMessage message={m.pips_pager_orientation_description} /></p>

<Showcase columns={2} code={orientationCode} minHeight="0" disablePanZoom showOverflow fluid>
  {#each ['horizontal', 'vertical'] as const as orientation (orientation)}
    <figure>
      <PipsPager aria-label="{orientation} pages" numberOfPages={5} {orientation} bind:index={orientationIndex[orientation]} />
      <figcaption><code>{orientation}</code></figcaption>
    </figure>
  {/each}
</Showcase>

### {m.pips_pager_buttons_title()}

<p><I18nMarkupMessage message={m.pips_pager_buttons_description} /></p>

<Showcase columns={3} code={buttonsCode} minHeight="0" disablePanZoom showOverflow fluid>
  <figure>
    <PipsPager aria-label="Always" numberOfPages={5} buttonVisibility="visible" bind:index={buttonsIndex.visible} />
    <figcaption><code>buttonVisibility="visible"</code></figcaption>
  </figure>
  <figure>
    <PipsPager aria-label="On hover" numberOfPages={5} buttonVisibility="hover" bind:index={buttonsIndex.hover} />
    <figcaption><code>buttonVisibility="hover"</code></figcaption>
  </figure>
  <figure>
    <PipsPager aria-label="Wrap" numberOfPages={5} buttonVisibility="visible" wrap bind:index={buttonsIndex.wrap} />
    <figcaption><code>wrap</code></figcaption>
  </figure>
</Showcase>

### {m.pips_pager_max_visible_title()}

<p><I18nMarkupMessage message={m.pips_pager_max_visible_description} /></p>

<Showcase columns={1} code={maxVisibleCode} minHeight="0" disablePanZoom showOverflow fluid>
  <figure>
    <PipsPager aria-label="Chapters" numberOfPages={20} maxVisiblePips={7} buttonVisibility="visible" bind:index={longIndex} />
    <figcaption>{m.pips_pager_chapter({ page: longIndex + 1, total: 20 })}</figcaption>
  </figure>
</Showcase>

### {m.pips_pager_numbers_title()}

<p><I18nMarkupMessage message={m.pips_pager_numbers_description} /></p>

<Showcase columns={1} code={numbersCode} minHeight="0" disablePanZoom showOverflow fluid>
  <figure>
    <PipsPager aria-label="Steps" numberOfPages={8} showNumbers bind:index={numbersIndex} />
    <figcaption><code>showNumbers</code></figcaption>
  </figure>
</Showcase>

<style>
  figure { margin: 0; width: 100%; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .stack { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; width: 100%; }
</style>
