<script lang="ts">
  import { TabView, TabViewTab } from '$lib/index.js';
  import Showcase from '$site/components/showcase/showcase.svelte';
  import { DocumentRegular, MailRegular, CalendarLtrRegular } from 'fluentui-icons-svelte';
  import { m } from '$i18n/messages.js';

  let activeTab = $state('document');

  // The panel shares the surface of the selected tab, which is what its feet curve out into.
  const panelStyle =
    'background: var(--fs-solid-background-quaternary); border: 1px solid var(--fs-card-stroke-default); border-radius: 0.4375rem; padding: 1rem; margin: 0;';
</script>

# TabView

{m.tab_view_description()}

<Showcase columns={1} columnWidth="680px" >
  <div style="width: 100%">
    <TabView bind:activeTab closable listProps={{ 'aria-label': 'Workspaces' }} showNewTabButton>
      <TabViewTab value="document" icon={DocumentRegular}>Document</TabViewTab>
      <TabViewTab value="mail" icon={MailRegular}>Mail</TabViewTab>
      <TabViewTab value="calendar" icon={CalendarLtrRegular}>Calendar</TabViewTab>
    </TabView>
    <div role="tabpanel" style={panelStyle}>
      {#if activeTab === 'document'}
        The document you are working on.
      {:else if activeTab === 'mail'}
        Everything that landed in your inbox.
      {:else}
        What the rest of the week looks like.
      {/if}
    </div>
  </div>
</Showcase>

