{#snippet action()}
  <Button appearance="standard" onclick={() => (open = false)}>Got it</Button>
{/snippet}

<Button bind:ref={target} onclick={() => (open = !open)}>Save</Button>
<TeachingTip bind:open {target}>
  <TeachingTipPreview><img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=640&h=320&fit=crop&q=60" alt="" /></TeachingTipPreview>
  <TeachingTipHeader title="Save automatically" />
