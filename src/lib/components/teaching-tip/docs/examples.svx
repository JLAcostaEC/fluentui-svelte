<script lang="ts">
  import { I18nMarkupMessage } from '@jlacostaec/paraglide-markup-svelte';
  import { TeachingTip, TeachingTipPreview, TeachingTipHeader, TeachingTipFooter, Button } from '#lib/index.js';
  import LightbulbRegular from 'fluentui-icons-svelte/LightbulbRegular.svelte';
  import { driver, type Driver, type DriveStep } from 'driver.js/headless';
  import Showcase from '#site/components/showcase/showcase.svelte';
  import { m } from '#i18n/messages.js';

  const image = 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=640&h=320&fit=crop&q=60';

  // Arrow
  let arrowTargets = $state<(HTMLElement | null)[]>([null, null]);

  // Target
  let saveOpen = $state(false);
  let saveButton = $state<HTMLElement | null>(null);

  // Step counter
  const steps = [
    { title: 'Search', text: 'Find files, people and settings from one place.' },
    { title: 'Share', text: 'Invite others to work on a file with you.' },
    { title: 'Settings', text: 'Change the theme and the language of the app.' }
  ];
  let targets = $state<(HTMLElement | null)[]>(steps.map(() => null));
  let tourOpen = $state(false);
  let step = $state(1);
  let current = $derived(steps[step - 1]);

  const startTour = () => {
    step = 1;
    tourOpen = true;
  };

  // driver.js
  const driverSteps: DriveStep[] = [
    {
      element: '#driver-new',
      advanceOn: 'click',
      data: { title: 'Create a file', text: 'Click New to start a blank document.' }
    },
    { element: '#driver-share', data: { title: 'Share', text: 'Invite others to work on the file with you.' } },
    { element: '#driver-settings', data: { title: 'Settings', text: 'Change the theme and the language of the app.' } }
  ];
  let tour: Driver | undefined;
  let driverOpen = $state(false);
  let driverTarget = $state<HTMLElement | null>(null);
  let driverStep = $state<DriveStep>();
  let driverIndex = $state(0);
  let driverLast = $state(false);

  const startDriver = () => {
    tour ??= driver({
      steps: driverSteps,
      onHighlighted: (element, step, { driver }) => {
        driverTarget = element as HTMLElement;
        driverStep = step;
        driverIndex = driver.getActiveIndex() ?? 0;
        driverLast = driver.isLastStep();
        driverOpen = true;
      },
      onDestroyed: () => (driverOpen = false)
    });
    tour.drive();
  };

  $effect(() => () => tour?.destroy());

  const targetCode = `<script>
  import { TeachingTip, TeachingTipHeader, TeachingTipFooter, Button } from 'fluentui-svelte';

  let open = $state(false);
  let target = $state(null);
<\/script>

{#snippet action()}
  <Button appearance="standard" onclick={() => (open = false)}>Got it</Button>
{/snippet}

<Button bind:ref={target} onclick={() => (open = !open)}>Save</Button>

<TeachingTip bind:open {target} placement="bottom" lightDismiss>
  <TeachingTipHeader title="Save automatically" />
  <p>Your changes are saved to the cloud as you work.</p>
  <TeachingTipFooter {action} />
</TeachingTip>`;

  const arrowCode = `<script>
  import { TeachingTip, TeachingTipHeader, Button } from 'fluentui-svelte';

  let below = $state(null);
  let above = $state(null);
<\/script>

<Button bind:ref={below}>Below</Button>
<TeachingTip open target={below} placement="bottom" withArrow>
  <TeachingTipHeader title="Placed below" hideCloseButton />
  <p>The arrow points up at the button.</p>
</TeachingTip>

<Button bind:ref={above}>Above</Button>
<TeachingTip open target={above} placement="top" withArrow>
  <TeachingTipHeader title="Placed above" hideCloseButton />
  <p>The arrow points down at the button.</p>
</TeachingTip>`;

  const previewCode = `<script>
  import { TeachingTip, TeachingTipPreview, TeachingTipHeader } from 'fluentui-svelte';

  const image = '${image}';
<\/script>

<TeachingTip open>
  <TeachingTipPreview><img src={image} alt="" /></TeachingTipPreview>
  <TeachingTipHeader title="New wallpapers" hideCloseButton />
  <p>Pick one of the new landscapes from the personalization settings.</p>
</TeachingTip>

<TeachingTip open>
  <TeachingTipHeader title="New wallpapers" hideCloseButton />
  <p>Pick one of the new landscapes from the personalization settings.</p>
  <TeachingTipPreview><img src={image} alt="" /></TeachingTipPreview>
</TeachingTip>`;

  const headerCode = `<script>
  import { TeachingTip, TeachingTipHeader } from 'fluentui-svelte';
  import LightbulbRegular from 'fluentui-icons-svelte/LightbulbRegular.svelte';
<\/script>

<TeachingTip open>
  <TeachingTipHeader title="Pinned files" description="New in this version" icon={LightbulbRegular} />
  <p>Pin the files you use the most to find them at the top of the list.</p>
</TeachingTip>

<TeachingTip open>
  <TeachingTipHeader title="Pinned files" hideCloseButton />
  <p>Pin the files you use the most to find them at the top of the list.</p>
</TeachingTip>`;

  const stepsCode = `<script>
  import { TeachingTip, TeachingTipHeader, TeachingTipFooter, Button } from 'fluentui-svelte';

  const steps = [
    { title: 'Search', text: 'Find files, people and settings from one place.' },
    { title: 'Share', text: 'Invite others to work on a file with you.' },
    { title: 'Settings', text: 'Change the theme and the language of the app.' }
  ];

  let targets = $state(steps.map(() => null));
  let open = $state(false);
  let step = $state(1);
  let current = $derived(steps[step - 1]);

  const start = () => {
    step = 1;
    open = true;
  };
<\/script>

{#snippet action()}
  <Button appearance="standard" disabled={step === 1} onclick={() => step--}>Back</Button>
  {#if step < steps.length}
    <Button onclick={() => step++}>Next</Button>
  {:else}
    <Button onclick={() => (open = false)}>Finish</Button>
  {/if}
{/snippet}

<Button onclick={start}>Start the tour</Button>

{#each steps as { title }, i (title)}
  <Button appearance="subtle" bind:ref={targets[i]}>{title}</Button>
{/each}

<TeachingTip bind:open target={targets[step - 1]} placement="bottom" withArrow>
  <TeachingTipHeader title={current.title} {step} totalSteps={steps.length} />
  <p>{current.text}</p>
  <TeachingTipFooter {action} />
</TeachingTip>`;

  const driverCode = `<script>
  import { TeachingTip, TeachingTipHeader, TeachingTipFooter, Button } from 'fluentui-svelte';
  import { driver } from 'driver.js/headless';

  const steps = [
    {
      element: '#driver-new',
      advanceOn: 'click',
      data: { title: 'Create a file', text: 'Click New to start a blank document.' }
    },
    { element: '#driver-share', data: { title: 'Share', text: 'Invite others to work on the file with you.' } },
    { element: '#driver-settings', data: { title: 'Settings', text: 'Change the theme and the language of the app.' } }
  ];

  let tour;
  let open = $state(false);
  let target = $state(null);
  let current = $state();
  let index = $state(0);
  let last = $state(false);

  const start = () => {
    tour ??= driver({
      steps,
      onHighlighted: (element, step, { driver }) => {
        target = element;
        current = step;
        index = driver.getActiveIndex() ?? 0;
        last = driver.isLastStep();
        open = true;
      },
      onDestroyed: () => (open = false)
    });
    tour.drive();
  };

  $effect(() => () => tour?.destroy());
<\/script>

{#snippet action()}
  <Button appearance="standard" disabled={index === 0} onclick={() => tour.movePrevious()}>Back</Button>
  <Button onclick={() => tour.moveNext()}>{last ? 'Finish' : 'Next'}</Button>
{/snippet}

<Button onclick={start}>Start the tour</Button>

<Button id="driver-new" appearance="subtle">New</Button>
<Button id="driver-share" appearance="subtle">Share</Button>
<Button id="driver-settings" appearance="subtle">Settings</Button>

<TeachingTip bind:open {target} placement="bottom" withArrow onOpenChange={(open) => !open && tour?.destroy()}>
  <TeachingTipHeader title={current?.data.title} step={index + 1} totalSteps={steps.length} />
  <p>{current?.data.text}</p>
  <TeachingTipFooter {action} />
</TeachingTip>`;
</script>

### {m.teaching_tip_target_title()}

<p><I18nMarkupMessage message={m.teaching_tip_target_description} /></p>

{#snippet saveAction()}
  <Button appearance="standard" onclick={() => (saveOpen = false)}>Got it</Button>
{/snippet}

<Showcase columns={1} code={targetCode} minHeight="320px" disablePanZoom autoCenter>
  <Button bind:ref={saveButton} onclick={() => (saveOpen = !saveOpen)}>Save</Button>
  <TeachingTip bind:open={saveOpen} target={saveButton} placement="bottom" lightDismiss>
    <TeachingTipHeader title="Save automatically" />
    <p>Your changes are saved to the cloud as you work.</p>
    <TeachingTipFooter action={saveAction} />
  </TeachingTip>
</Showcase>

### {m.teaching_tip_arrow_title()}

<p><I18nMarkupMessage message={m.teaching_tip_arrow_description} /></p>

<Showcase columns={1} code={arrowCode} minHeight="0" disablePanZoom fluid>
  <figure>
    <div class="arrow-demo">
      <Button bind:ref={arrowTargets[0]}>Below</Button>
    </div>
    <TeachingTip open target={arrowTargets[0]} placement="bottom" withArrow>
      <TeachingTipHeader title="Placed below" hideCloseButton />
      <p>The arrow points up at the button.</p>
    </TeachingTip>
    <figcaption><code>placement="bottom"</code></figcaption>
  </figure>
  <figure>
    <div class="arrow-demo end">
      <Button bind:ref={arrowTargets[1]}>Above</Button>
    </div>
    <TeachingTip open target={arrowTargets[1]} placement="top" withArrow>
      <TeachingTipHeader title="Placed above" hideCloseButton />
      <p>The arrow points down at the button.</p>
    </TeachingTip>
    <figcaption><code>placement="top"</code></figcaption>
  </figure>
</Showcase>

### {m.teaching_tip_preview_title()}

<p><I18nMarkupMessage message={m.teaching_tip_preview_description} /></p>

<Showcase columns={2} code={previewCode} minHeight="0" disablePanZoom fluid>
  <figure>
    <TeachingTip open>
      <TeachingTipPreview><img src={image} alt="" /></TeachingTipPreview>
      <TeachingTipHeader title="New wallpapers" hideCloseButton />
      <p>Pick one of the new landscapes from the personalization settings.</p>
    </TeachingTip>
    <figcaption>{m.teaching_tip_preview_top()}</figcaption>
  </figure>
  <figure>
    <TeachingTip open>
      <TeachingTipHeader title="New wallpapers" hideCloseButton />
      <p>Pick one of the new landscapes from the personalization settings.</p>
      <TeachingTipPreview><img src={image} alt="" /></TeachingTipPreview>
    </TeachingTip>
    <figcaption>{m.teaching_tip_preview_bottom()}</figcaption>
  </figure>
</Showcase>

### {m.teaching_tip_header_title()}

<p><I18nMarkupMessage message={m.teaching_tip_header_description} /></p>

<Showcase columns={2} code={headerCode} minHeight="0" disablePanZoom fluid>
  <figure>
    <TeachingTip open>
      <TeachingTipHeader title="Pinned files" description="New in this version" icon={LightbulbRegular} />
      <p>Pin the files you use the most to find them at the top of the list.</p>
    </TeachingTip>
    <figcaption><code>icon</code>, <code>description</code></figcaption>
  </figure>
  <figure>
    <TeachingTip open>
      <TeachingTipHeader title="Pinned files" hideCloseButton />
      <p>Pin the files you use the most to find them at the top of the list.</p>
    </TeachingTip>
    <figcaption><code>hideCloseButton</code></figcaption>
  </figure>
</Showcase>

### {m.teaching_tip_steps_title()}

<p><I18nMarkupMessage message={m.teaching_tip_steps_description} /></p>

{#snippet tourAction()}
  <Button appearance="standard" disabled={step === 1} onclick={() => step--}>Back</Button>
  {#if step < steps.length}
    <Button onclick={() => step++}>Next</Button>
  {:else}
    <Button onclick={() => (tourOpen = false)}>Finish</Button>
  {/if}
{/snippet}

<Showcase columns={1} code={stepsCode} minHeight="360px" disablePanZoom autoCenter>
  <div class="tour">
    <Button onclick={startTour}>Start the tour</Button>
    <div class="toolbar">
      {#each steps as { title }, i (title)}
        <Button appearance="subtle" bind:ref={targets[i]}>{title}</Button>
      {/each}
    </div>
  </div>
  <TeachingTip bind:open={tourOpen} target={targets[step - 1]} placement="bottom" withArrow>
    <TeachingTipHeader title={current.title} {step} totalSteps={steps.length} />
    <p>{current.text}</p>
    <TeachingTipFooter action={tourAction} />
  </TeachingTip>
</Showcase>

### {m.teaching_tip_driver_title()}

<p><I18nMarkupMessage message={m.teaching_tip_driver_description} /></p>

{#snippet driverAction()}
  <Button appearance="standard" disabled={driverIndex === 0} onclick={() => tour?.movePrevious()}>Back</Button>
  <Button onclick={() => tour?.moveNext()}>{driverLast ? 'Finish' : 'Next'}</Button>
{/snippet}

<Showcase columns={1} code={driverCode} minHeight="360px" disablePanZoom autoCenter>
  <div class="tour">
    <Button onclick={startDriver}>Start the tour</Button>
    <div class="toolbar">
      <Button id="driver-new" appearance="subtle">New</Button>
      <Button id="driver-share" appearance="subtle">Share</Button>
      <Button id="driver-settings" appearance="subtle">Settings</Button>
    </div>
  </div>
  <TeachingTip
    bind:open={driverOpen}
    target={driverTarget}
    placement="bottom"
    withArrow
    onOpenChange={(open) => !open && tour?.destroy()}
  >
    <TeachingTipHeader title={driverStep?.data?.title ?? ''} step={driverIndex + 1} totalSteps={driverSteps.length} />
    <p>{driverStep?.data?.text}</p>
    <TeachingTipFooter action={driverAction} />
  </TeachingTip>
</Showcase>

<style>
  figure {
    width: 100%;
    min-width: 0;
  }
  .arrow-demo {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    height: 11rem;
    &.end {
      align-items: flex-end;
    }
  }
  .tour {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .toolbar {
    display: flex;
    gap: 0.5rem;
  }
</style>
