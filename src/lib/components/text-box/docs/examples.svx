<script lang="ts">
  import { I18nMarkupMessage } from '@jlacostaec/paraglide-markup-svelte';
  import { TextBox } from '#lib/index.js';
  import { MailRegular } from 'fluentui-icons-svelte';
  import Showcase from '#site/components/showcase/showcase.svelte';
  import { m } from '#i18n/messages.js';

  const typeCode = `
<TextBox type="text" placeholder="Text" />
<TextBox type="search" placeholder="Search" />
<TextBox type="password" placeholder="Password" />
<TextBox type="number" placeholder="Number" />`;

  const sizeCode = `
<TextBox size="small" placeholder="Small" />
<TextBox size="medium" placeholder="Medium" />
<TextBox size="large" placeholder="Large" />`;

  const contentCode = `
<script>
  import { MailRegular } from 'fluentui-icons-svelte';
<\/script>

<TextBox contentBefore="https://" placeholder="Website" />
<TextBox contentAfter=".com" placeholder="Domain" />
<TextBox contentBefore="$" contentAfter=".00" type="number" placeholder="Price" />
<TextBox contentBefore={MailRegular} placeholder="Email" />`;

  const readonlyCode = `<TextBox readonly value="Read-only value" />`;

  const hideButtonsCode = `<TextBox type="search" hideActionButtons placeholder="No action buttons" />`;
  const shapesCode = `<script>
  import { TextBox } from 'fluentui-svelte';
<\/script>

<TextBox shape="rounded" aria-label="rounded" placeholder="rounded" />
<TextBox shape="square" aria-label="square" placeholder="square" />
<TextBox shape="circular" aria-label="circular" placeholder="circular" />`;
</script>

### {m.global_shape()}

<p><I18nMarkupMessage message={m.textual_input_shapes_description} /></p>

<Showcase columns={1} minHeight="0" code={shapesCode} disablePanZoom showOverflow fluid>
  <div class="input-shapes">
    <TextBox shape="rounded" aria-label="rounded" placeholder="rounded" />
    <TextBox shape="square" aria-label="square" placeholder="square" />
    <TextBox shape="circular" aria-label="circular" placeholder="circular" />
  </div>
</Showcase>

### {m.tb_type_title()}

<p class="fs-docs"><I18nMarkupMessage message={m.tb_type_description} /></p>

<Showcase code={typeCode}>
  <TextBox type="text" placeholder="Text" />
  <TextBox type="search" placeholder="Search" />
  <TextBox type="password" placeholder="Password" />
  <TextBox type="number" placeholder="Number" />
</Showcase>

### {m.global_size()}

<p class="fs-docs"><I18nMarkupMessage message={m.tb_size_description} /></p>

<Showcase code={sizeCode}>
  <TextBox size="small" placeholder="Small" />
  <TextBox size="medium" placeholder="Medium" />
  <TextBox size="large" placeholder="Large" />
</Showcase>

### {m.tb_content_title()}

<p class="fs-docs"><I18nMarkupMessage message={m.tb_content_description} /></p>

<Showcase columns={2} code={contentCode}>
  <TextBox contentBefore="https://" placeholder="Website" />
  <TextBox contentAfter=".com" placeholder="Domain" />
  <TextBox contentBefore="$" contentAfter=".00" type="number" placeholder="Price" />
  <TextBox contentBefore={MailRegular} placeholder="Email" />
</Showcase>

### {m.tb_readonly_title()}

<p class="fs-docs"><I18nMarkupMessage message={m.tb_readonly_description} /></p>

