</Showcase>

### {m.tb_hide_buttons_title()}

<p class="fs-docs"><I18nMarkupMessage message={m.tb_hide_buttons_description} /></p>

<Showcase columns={1} code={hideButtonsCode}>
  <TextBox type="search" hideActionButtons placeholder="No action buttons" />
</Showcase>
<style>
  .input-shapes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
