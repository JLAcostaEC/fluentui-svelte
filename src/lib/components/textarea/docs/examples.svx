<TextArea resize="none" placeholder="No resize" />
<TextArea resize="vertical" placeholder="Vertical resize" />
<TextArea resize="both" placeholder="Resize both" />`;

  const onChangeCode = `<TextArea onChange={(e) => console.log(e)} placeholder="Type..." />`;
  const shapesCode = `<script>
  import { TextArea } from 'fluentui-svelte';
<\/script>

<TextArea shape="rounded" aria-label="rounded" placeholder="rounded" />
<TextArea shape="square" aria-label="square" placeholder="square" />`;
</script>

### {m.global_shape()}

<p><I18nMarkupMessage message={m.text_area_shapes_description} /></p>

<Showcase columns={1} minHeight="0" code={shapesCode} disablePanZoom showOverflow fluid>
