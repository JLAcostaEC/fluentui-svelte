      {#snippet leftControls()}
        <TitleBarLeftControls
          back
          globalNav
          globalNavExpanded={navExpanded}
          onGlobalNav={() => (navExpanded = !navExpanded)}
          appIcon={AppsRegular}
          appName="FluentUI App"
        />
      {/snippet}
      {#snippet rightControls()}
        <TitleBarRightControls />
      {/snippet}
    </TitleBar>
  </div>
</Showcase>

