    & i { background: var(--fs-text-on-accent-primary); border-radius: 0.25rem; }
    & i:nth-child(2), & i:nth-child(3) { opacity: 0.72; }
    & i:last-child { opacity: 0.6; border-radius: 50%; }
  }
  .scene-piece {
    position: absolute;
    animation: about-float 7s ease-in-out infinite;
    & :global(.fs-card) { padding: 0.7rem; gap: 0.55rem; }
    &.notifications { inset-block-start: 14%; inset-inline-start: 6%; animation-delay: -1s; }
    &.checkbox {
      inset-block-end: 12%;
      inset-inline-start: 9%;
      animation-delay: -3s;
      & :global(.fs-card > .fs-checkbox) { position: relative; inset: auto; }
    }
    &.slider { inset-block-start: 12%; inset-inline-end: 6%; width: 26%; animation-delay: -2s; }
    &.persona { inset-block-end: 14%; inset-inline-end: 8%; animation-delay: -4s; }
  }
  .scene-dot {
    position: absolute;
    inline-size: 0.6rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--fs-accent-fill-default);
    box-shadow: 0 0.25rem 0.5rem #0002;
    &.first { inset-block-start: 22%; inset-inline-start: 30%; }
    &.second { inset-block-end: 17%; inset-inline-start: 36%; opacity: 0.6; }
