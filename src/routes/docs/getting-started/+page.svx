### {m.gs_optional_font_title()}

<DocPanel label={m.gs_optional_badge()}>

{m.gs_optional_font_description()}

<Steps>
<Step title={m.gs_font_step_download()}>

<p class="fs-docs"><I18nMarkupMessage message={m.gs_optional_font_download_description} /></p>

<ul class="font-downloads">
  <li><a href="/fonts/selawik/selawk.ttf" download>selawk.ttf</a></li>
  <li><a href="/fonts/selawik/selawksb.ttf" download>selawksb.ttf</a></li>
  <li><a href="/fonts/selawik/selawkb.ttf" download>selawkb.ttf</a></li>
  <li><a href="/fonts/selawik/SIL%20Open%20Font%20License.txt" download>{m.gs_optional_font_license_label()}</a></li>
</ul>

</Step>
<Step title={m.gs_font_step_declare()}>

<p class="fs-docs"><I18nMarkupMessage message={m.gs_optional_font_configuration_description} /></p>

```css
@font-face {
  font-family: 'Selawik';
  src: url('/fonts/selawik/selawk.ttf') format('truetype');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Selawik';
  src: url('/fonts/selawik/selawksb.ttf') format('truetype');
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'Selawik';
  src: url('/fonts/selawik/selawkb.ttf') format('truetype');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}
```

</Step>
<Step title={m.gs_font_step_import()}>

<p class="fs-docs"><I18nMarkupMessage message={m.gs_optional_font_import_description} /></p>

```js
import 'fluentui-svelte/theme.css';
import 'fluentui-svelte/typography.css';
import '../app.css';
```

<p class="fs-docs"><I18nMarkupMessage message={m.gs_optional_font_fallback_note} /></p>

</Step>
</Steps>

</DocPanel>

