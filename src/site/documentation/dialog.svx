<script>
import { Dialog, DialogTrigger, DialogSurface, DialogTitle, DialogContent, DialogActions, InfoBar, Button } from '$lib/index.js';
import Showcase from '$site/components/showcase/showcase.svelte';
import { m } from '$i18n/messages.js';

let actionsDialog = $state();
let longDialog = $state();

const exampleText =
    '<article><p>Follow this guide to learn how to properly turn on and shut down your Windows 11 computer. These steps are easy and ensure the smooth operation of your system.</p><h2>Turning On Your Computer</h2><ol><li><strong>Locate the Power Button:</strong><ul><li><i>For laptops:</i> The power button is usually located above the keyboard or on the sides of the device.</li><li><i>For desktops:</i> The power button is typically found on the front or top of the CPU case.</li></ul></li><li><strong>Press the Power Button:</strong> Press and hold the power button for 1-2 seconds. You may hear a sound, and the device will start booting.</li><li><strong>Wait for Windows 11 to Load:</strong> The Windows logo will appear, followed by the login screen.</li><li><strong>Login:</strong> Enter your <i>username</i> and <i>password</i>, or use <i>Windows Hello</i> if you have configured it (PIN, fingerprint, or facial recognition).</li></ol><h2>Shutting Down Your Computer</h2><ol><li><strong>Open the Start Menu:</strong> Click the Start button on the taskbar, located at the bottom center of the screen. It looks like a Windows logo.</li><li><strong>Select the Power Icon:</strong> In the Start menu, find the power icon (a circle with a vertical line at the top).</li><li><strong>Choose "Shut Down":</strong> Click on the power icon, then select <strong>Shut Down</strong>. Your computer will close all running applications and turn off.</li><li><strong>Wait for Complete Shutdown:</strong> Ensure the computer has powered off completely before unplugging it or closing the lid.</li></ol><h2>Additional Tips</h2><ul><li>To restart your computer, choose <strong>"Restart"</strong> instead of "Shut Down" from the power menu.</li><li>To save power without shutting down, select <strong>"Sleep"</strong>. This allows you to resume your work quickly.</li><li>Always save your work before shutting down or restarting the computer to avoid losing unsaved changes.</li></ul><h2>Important Notes</h2><p><strong>Note:</strong> If your system becomes unresponsive, you can perform a hard shutdown by pressing and holding the power button for 5-10 seconds. However, use this method only as a last resort, as it can lead to data loss.</p></article>';
</script>

# Dialog

{m.dialog_description()}

<InfoBar status="critical" style="multiline" title={m.dialog_early_access_title()} hideCloseButton>
  <p>
    {m.dialog_early_access_description()}
  </p>
</InfoBar>

<Showcase columns={1} minHeight="250px">
  <Dialog>
    <DialogTrigger>Open Dialog</DialogTrigger>
    <DialogSurface>
      <DialogTitle>Dialog Title</DialogTitle>
      <DialogContent>
        <p>
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, voluptates. Quisquam, voluptates. Quisquam,
        </p>
      </DialogContent>
    </DialogSurface>
  </Dialog>

  <Dialog bind:this={actionsDialog}>
    <DialogTrigger>Actions Dialog</DialogTrigger>
    <DialogSurface>
      <DialogTitle>Dialog Title</DialogTitle>
      <DialogContent>
        <p>
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, voluptates. Quisquam, voluptates. Quisquam,
        </p>
      </DialogContent>
      <DialogActions fluid>
        <Button style="flex: 1 1 auto;">Save</Button>
        <Button style="flex: 1 1 auto;" appearance="standard" onclick={() => actionsDialog.closeDialog()}>Close</Button>
      </DialogActions>
    </DialogSurface>
  </Dialog>

  <Dialog bind:this={longDialog}>
    <DialogTrigger>Scroll Long Content Dialog</DialogTrigger>
    <DialogSurface>
      <DialogTitle>How to Turn On and Off Windows 11</DialogTitle>
      <DialogContent>
        {@html exampleText}
      </DialogContent>
      <DialogActions fluid>
        <Button style="flex: 1 1 auto;">Save</Button>
        <Button style="flex: 1 1 auto;" appearance="standard" onclick={() => longDialog.closeDialog()}>Close</Button>
      </DialogActions>
    </DialogSurface>
  </Dialog>
</Showcase>

{m.dialog_composition_description()}

- `Dialog`: {m.dialog_composition_dialog_description()}
- `DialogTrigger`: {m.dialog_composition_dialogtrigger_description()}
- `DialogSurface`: {m.dialog_composition_dialogsurface_description()}
- `DialogTitle`: {m.dialog_composition_dialogtitle_description()}
- `DialogContent`: {m.dialog_composition_dialogcontent_description()}
