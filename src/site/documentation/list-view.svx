<script>
  import { ListView, ListViewItem } from 'fluentui-svelte';
  let list = ['A', 'B', 'C'];
  let selected = ['A'];
</script>

<ListView selectedItems={selected}>
  {#each list as item (item)}
    <ListViewItem value={item}>{item}</ListViewItem>
  {/each}
</ListView>
