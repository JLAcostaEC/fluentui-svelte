```svelte
<script>
  import { 
    Button, 
    Menu, 
    MenuTrigger, 
    MenuPopover, 
    MenuList, 
    MenuGroup, 
    MenuItem, 
    MenuDivider 
  } from 'fluentui-svelte';
</script>

<Menu>
  <MenuTrigger>
    {#snippet children({ state, menuTriggerProps, primaryButtonProps })}
      <Button bind:ref={state.ref} {...menuTriggerProps}>Open Menu</Button>
    {/snippet}
  </MenuTrigger>
  <MenuPopover>
    <MenuList>
      <MenuGroup header="Group 1">
        <MenuItem>Item 1</MenuItem>
        <MenuItem>Item 2</MenuItem>
      </MenuGroup>
      <MenuDivider />
      <MenuGroup header="Group 2">
        <MenuItem>Item 3</MenuItem>
        <MenuItem>Item 4</MenuItem>
      </MenuGroup>
    </MenuList>
  </MenuPopover>
</Menu>
```

## {m.menu_component_props_menu_title()}

| **Name**                  | **Type**                                                    | **Description**                                                                          |
| ------------------------- | ----------------------------------------------------------- | ---------------------------------------------------------------------------------------- |
| `checkedValues`           | `Record<string, string[]>`                                  | {m.menu_props_checkedvalues_description()}                                               |
| `onCheckedValueChange`    | `(e: Event, checkedValues: Record<string, string[]>) => void` | {m.menu_props_oncheckedvaluechange_description()}                                     |
| `hasCheckmarks`           | `boolean`                                                   | {m.menu_props_hascheckmarks_description()}                                               |
| `hasIcons`                | `boolean`                                                   | {m.menu_props_hasicons_description()}                                                    |
| `openingDelay`            | `number`                                                    | {m.menu_props_openingdelay_description()}                                                |
| `open`                    | `boolean`                                                   | {m.menu_props_open_description()}                                                        |
| `onOpenChange`            | `(e: Event, open: boolean) => void`                         | {m.menu_props_onopenchange_description()}                                                |
| `openOnHover`             | `boolean`                                                   | {m.menu_props_openonhover_description()}                                                 |
| `persistOnItemActivation` | `boolean`                                                   | {m.menu_props_persistonitemactivation_description()}                                     |
| `positionConfig`          | `Partial<ComputePositionConfig>`                            | {m.menu_props_positionconfig_description()}                                              |

## {m.menu_component_props_menutrigger_title()}

| **Name**   | **Type**                            | **Description**                                             |
| ---------- | ----------------------------------- | ----------------------------------------------------------- |
| `shape`    | `rounded` \| `circular` \| `square` | {m.menu_props_shape_description()}                          |
| `icon`     | `Snippet` \| `Component`            | {m.menu_props_icon_description()}                           |
| `disabled` | `boolean`                           | {m.menu_props_disabled_description()}                       |

## {m.menu_component_props_menuitem_title()}

| **Name**           | **Type**                 | **Description**                                                      |
| ------------------ | ------------------------ | -------------------------------------------------------------------- |
| `icon`             | `Snippet` \| `Component` | {m.menu_props_menuitem_icon_description()}                           |
| `subText`          | `string`                 | {m.menu_props_subtext_description()}                                 |
| `secondaryContent` | `string`                 | {m.menu_props_secondarycontent_description()}                        |
| `href`             | `string`                 | {m.menu_props_href_description()}                                    |
| `disabled`         | `boolean`                | {m.menu_props_menuitem_disabled_description()}                       |
| `onClick`          | `(e: Event) => void`     | {m.menu_props_onclick_description()}                                 |

## {m.menu_component_props_menuitemcheckboxswitchradio_title()}

| **Name**             | **Type**  | **Description**                                                                |
| -------------------- | --------- | ------------------------------------------------------------------------------ |
