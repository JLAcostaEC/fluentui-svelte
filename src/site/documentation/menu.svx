### {m.menu_checkable_nested_submenus_title()}

<Menu hasCheckmarks hasIcons {checkedValues} onCheckedValueChange={(e, value) => {
  checkedValues = value;
}}>
  <MenuTrigger>
    {#snippet children({state, menuTriggerProps, primaryButtonProps})}
      <Button isMenuButton bind:ref={state.ref} {...menuTriggerProps}>
        <AccessTimeRegular /> Open Menu
      </Button>
    {/snippet}
  </MenuTrigger>
  <MenuPopover>
    <MenuList>
      <MenuItem subText="An explanation here">
        Item With Subtext
      </MenuItem>
      <MenuDivider />
      <MenuItem disabled>
        I'm Disabled
      </MenuItem>
      <MenuItemCheckbox name="item4" value="item4" icon={AccessTimeRegular} subText="Click doesn't close menu">
        I'm a checkbox
      </MenuItemCheckbox>
      <MenuItemSwitch subText="Click doesn't close menu">
        I'm a switch
      </MenuItemSwitch>
      <MenuItemRadio name="item6" value="item6" icon={AccessTimeRegular} subText="Click closes menu">
        I'm a radio
      </MenuItemRadio>
      <Menu>
        <MenuTrigger>
          {#snippet children({state, menuTriggerProps, primaryButtonProps})}
            <Button bind:ref={state.ref} {...menuTriggerProps}>I'm a nested menu</Button>
          {/snippet}
        </MenuTrigger>
        <MenuPopover>
          <MenuList>
            <MenuItem >
              Item 1
            </MenuItem>
            <MenuItem >
              Item 2
            </MenuItem>
            <MenuDivider />
            <MenuItem>
              Item 3
            </MenuItem>
            <Menu>
              <MenuTrigger>
                {#snippet children({state, menuTriggerProps, primaryButtonProps})}
                  <Button bind:ref={state.ref} icon={ChevronRightFilled} {...menuTriggerProps}>I'm a nested menu</Button>
                {/snippet}
              </MenuTrigger>
              <MenuPopover>
                <MenuList>
                    <MenuItem >
                      Item 1
                    </MenuItem>
                    <MenuItem >
                      Item 2
                    </MenuItem>
                </MenuList>
              </MenuPopover>
            </Menu>
          </MenuList>
        </MenuPopover>
      </Menu>
    </MenuList>
  </MenuPopover>
</Menu>

```svelte
<script>
  import { 
    Button, 
    Menu, 
    MenuTrigger, 
    MenuPopover, 
    MenuList, 
    MenuGroup, 
    MenuItem, 
    MenuDivider, 
    MenuItemCheckbox, 
    MenuItemSwitch, 
    MenuItemRadio 
  } from 'fluentui-svelte';
  import { AccessTimeRegular, ChevronRightFilled } from 'fluentui-icons-svelte';
</script>

<Menu hasCheckmarks hasIcons {checkedValues} onCheckedValueChange={(e, value) => {
  checkedValues = value;
}}>
  <MenuTrigger>
    {#snippet children({state, menuTriggerProps, primaryButtonProps})}
      <Button isMenuButton bind:ref={state.ref} {...menuTriggerProps}>
        <AccessTimeRegular /> Open Menu
      </Button>
    {/snippet}
  </MenuTrigger>
  <MenuPopover>
    <MenuList>
      <MenuItem subText="Subtext for Item 1">
        Item 1
      </MenuItem>
      <MenuItem >
        Item 2
      </MenuItem>
      <MenuDivider />
      <MenuItem disabled>
        Item 3
      </MenuItem>
      <MenuItemCheckbox name="item4" value="item4" icon={AccessTimeRegular}>
        Item 4
      </MenuItemCheckbox>
      <MenuItemSwitch>
        Item 5
      </MenuItemSwitch>
      <MenuItemRadio name="item6" value="item6" icon={AccessTimeRegular}>
        Item 6
      </MenuItemRadio>
      <MenuItem icon={AccessTimeRegular}>
        Menu Button
      </MenuItem>
      <Menu>
        <MenuTrigger>
          {#snippet children({state, menuTriggerProps, primaryButtonProps})}
            <Button bind:ref={state.ref} {...menuTriggerProps}> Open Menu 2</Button>
          {/snippet}
        </MenuTrigger>
        <MenuPopover>
          <MenuList>
            <MenuItem >
              Item 1
            </MenuItem>
            <MenuItem >
              Item 2
            </MenuItem>
            <MenuDivider />
            <MenuItem disabled>
              Item 3
            </MenuItem>
            <MenuItem>
              Item 4
            </MenuItem>
            <Menu>
              <MenuTrigger>
                {#snippet children({state, menuTriggerProps, primaryButtonProps})}
                  <Button 
                    bind:ref={state.ref}
                    icon={ChevronRightFilled} 
                    {...menuTriggerProps}
                  >
                    Open Menu 3
                  </Button>
                {/snippet}
              </MenuTrigger>
              <MenuPopover>
                <MenuList>
                    <MenuItem >
                      Item 1
                    </MenuItem>
                    <MenuItem >
                      Item 2
                    </MenuItem>
                  <MenuDivider />
                    <MenuItem disabled>
                      Item 3
                    </MenuItem>
                    <MenuItem>
                      Item 4
                    </MenuItem>
                </MenuList>
              </MenuPopover>
            </Menu>
          </MenuList>
        </MenuPopover>
      </Menu>
    </MenuList>
  </MenuPopover>
</Menu>
```

